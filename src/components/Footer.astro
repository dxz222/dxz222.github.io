---
import { FOOTER_CREDIT, SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<footer>
  <div class="footer-inner">
    <div>
      <strong>{SITE_TITLE}</strong>
      <p>AI for Science · Materials · Microscopy</p>
    </div>
    <div class="footer-links">
      {SOCIAL_LINKS.map((link) => (
        <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
          {link.label}
        </a>
      ))}
    </div>
  </div>
  <div class="credit">
    © {new Date().getFullYear()} {SITE_TITLE}. Built with <a href={FOOTER_CREDIT.sourceUrl}>{FOOTER_CREDIT.sourceLabel}</a>.
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0 1.25rem;
    color: var(--color-text-muted);
  }
  .footer-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding-x);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  strong { color: var(--color-text-main); font-size: 1.3rem; }
  p { margin: 0.35rem 0 0; font-size: 1.05rem; }
  .footer-links { display: flex; gap: 1.4rem; font-size: 1.05rem; }
  .credit { width: 100%; max-width: var(--max-width); margin: 2rem auto 0; padding: 0 var(--page-padding-x); font-size: 0.85rem; }
  @media (max-width: 560px) { .footer-inner { flex-direction: column; } }
</style>
