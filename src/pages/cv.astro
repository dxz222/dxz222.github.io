---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
const cvUrl = url('/files/CV_2026-08-17_xdai_v03.pdf');
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`CV | ${SITE_TITLE}`} description="Curriculum vitae of Xinzhe Dai" /></head>
  <body>
    <Header />
    <main>
      <div class="cv-heading">
        <h1>Curriculum vitae</h1>
        <a class="btn" href={cvUrl} download>Download PDF</a>
      </div>
      <object data={cvUrl} type="application/pdf">
        <p>Your browser cannot display the PDF. <a href={cvUrl}>Open the CV directly.</a></p>
      </object>
    </main>
    <Footer />
  </body>
</html>

<style>
  .cv-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  h1 { margin: 0; }
  object { width: 100%; height: 78vh; border: 1px solid var(--color-border); background: var(--color-bg-offset); }
  @media (max-width: 560px) { .cv-heading { align-items: flex-start; flex-direction: column; } }
</style>
