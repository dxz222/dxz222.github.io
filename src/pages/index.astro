---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import bibFileRaw from '../data/publications.bib?raw';
import { url } from '../utils/paths';

const selectedProjects = projectsData.slice(0, 3);
const publicationBlocks = bibFileRaw.split(/@\w+\s*\{/g).slice(1);
const selectedPublications = publicationBlocks
  .map((block) => {
    const field = (name: string) => block.match(new RegExp(name + '\\s*=\\s*\\{([^}]*)\\}', 'i'))?.[1] ?? '';
    return {
      title: field('title'),
      venue: field('journal') || field('booktitle') || field('publisher') || 'Research output',
      year: field('year'),
    };
  })
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">AI for Science | Materials Discovery</p>
          <h1>Xinzhe Dai</h1>
          <p class="role">PhD Researcher in Materials Science and Engineering at Cornell University</p>
          <p class="lead">
            I develop machine-learning methods to understand and design complex materials—from generative
            crystal models to data-centric tools for atomistic simulation and electron microscopy.
          </p>
          <div class="actions">
            <a class="btn" href={url('/projects')}>Explore projects</a>
            <a class="text-link" href={url('/about')}>More about me</a>
            <a class="text-link" href={url('/files/CV_2026-08-17_xdai_v03.pdf')} target="_blank">Download CV ↗</a>
          </div>
        </div>
        <img class="portrait" src={url('/profile.png')} alt="Portrait of Xinzhe Dai" />
      </section>

      <section class="focus">
        <p class="section-label">Research focus</p>
        <div class="focus-grid">
          <article><h2>Generative Materials</h2><p>Conditional diffusion and inpainting models for crystal structure prediction and materials discovery.</p></article>
          <article><h2>Scientific Machine Learning</h2><p>Physically grounded learning for atomistic simulations, interatomic potentials, and crystalline structure analysis.</p></article>
          <article><h2>AI for Microscopy</h2><p>Data-driven microscopy images and spectra denoising, atom localization, and local structural order deciphering.</p></article>
        </div>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="section-label">Selected work</p>
          <a href={url('/projects')}>View all →</a>
        </div>
        <div class="project-grid">
          {selectedProjects.map((project) => (
            <a class="project-card" href={project.link} target="_blank" rel="noopener noreferrer">
              <img src={url(project.heroImage)} alt="" />
              <div class="card-copy">
                <span>{project.year} · {project.status}</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section publications">
        <div class="section-heading">
          <p class="section-label">Recent publications</p>
          <a href={url('/publications')}>Full list →</a>
        </div>
        {selectedPublications.map((publication) => (
          <article class="pub-row">
            <span>{publication.year}</span>
            <div><h3>{publication.title}</h3><p>{publication.venue}</p></div>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main { padding-top: 0; }
  .hero { min-height: 72vh; display: grid; grid-template-columns: 1.35fr 0.65fr; align-items: center; gap: 5rem; padding: 5rem 0; }
  .eyebrow { margin: 0 0 1rem; color: var(--color-accent); font-size: 1.28rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; }
  .section-label { margin: 0; color: var(--color-accent); font-size: 1.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .hero h1 { font-size: clamp(3.35rem, 2.5vw, 4.15rem); letter-spacing: -0.05em; line-height: 0.97; margin: 0 0 1.5rem; }
  .role { font-size: 1.28rem; color: var(--color-text-main); margin-bottom: 1.25rem; }
  .lead { max-width: 720px; font-size: 1.38rem; line-height: 1.65; }
  .portrait { width: 100%; max-width: 310px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 2px; filter: grayscale(18%); }
  .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.25rem; }
  .text-link { font-size: 1.02rem; font-weight: 600; }
  .focus, .section { border-top: 1px solid var(--color-border); padding: 5rem 0; }
  .focus > .section-label { margin-bottom: 2.25rem; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; }
  .focus-grid h2 { border: 0; display: block; font-family: var(--font-sans); font-size: 1.5rem; margin: 0 0 0.85rem; padding: 0; }
  .focus-grid p { font-size: 1.12rem; line-height: 1.7; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-bottom: 2.75rem; }
  .section-heading > a { font-size: 1.05rem; font-weight: 600; }
  .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .project-card { color: inherit; border: 1px solid var(--color-border); text-decoration: none; background: var(--color-bg-offset); }
  .project-card:hover { text-decoration: none; transform: translateY(-3px); }
  .project-card img { width: 100%; aspect-ratio: 16 / 10; object-fit: contain; display: block; background: var(--color-bg-offset); }
  .card-copy { padding: 1.6rem; }
  .card-copy span { color: var(--color-accent); font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .card-copy h3 { color: var(--color-text-main); font-family: var(--font-sans); font-size: 1.5rem; margin: 0.8rem 0; }
  .card-copy p { font-size: 1.12rem; line-height: 1.65; margin: 0; }
  .pub-row { display: grid; grid-template-columns: 80px 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--color-border); }
  .pub-row > span { color: var(--color-accent); font-size: 1.2rem; font-weight: 700; }
  .pub-row h3 { color: var(--color-text-main); font-family: var(--font-sans); font-size: 1.2rem; margin: 0 0 0.25rem; }
  .pub-row p { margin: 0; font-size: 1.1rem; font-style: italic; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; min-height: auto; gap: 2.5rem; padding: 4rem 0; }
    .portrait { grid-row: 1; width: 190px; }
    .focus-grid, .project-grid { grid-template-columns: 1fr; }
    .focus-grid { gap: 1.5rem; }
  }
</style>
