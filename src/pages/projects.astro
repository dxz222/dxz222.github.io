---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import { url } from '../utils/paths';
const projects = [...projectsData].sort((a, b) => b.year - a.year);
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`Projects | ${SITE_TITLE}`} description="Selected research and open-source projects" /></head>
  <body>
    <Header />
    <main>
      <section class="page-hero">
        <h1>Research projects</h1>
        <div>Generative materials models, scientific machine learning, and open tools for microscopy.</div>
      </section>
      <section class="project-list">
        {projects.map((project) => (
          <article>
            {project.link ? (
              <a class="image-link" href={project.link} target="_blank" rel="noopener noreferrer">
                <img src={url(project.heroImage)} alt={project.title} />
              </a>
            ) : (
              <div class="image-link">
                <img src={url(project.heroImage)} alt={project.title} />
              </div>
            )}
            <div class="copy">
              <span>{project.year} · {project.status}</span>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer">View project ↗</a>
              )}
            </div>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-hero { padding: 0 0 5rem; }
  h1 { margin-bottom: 1.5rem; }
  .page-hero > div { max-width: 680px; color: var(--color-text-muted); font-size: 1.2rem; }
  .project-list { border-top: 1px solid var(--color-border); }
  article { display: grid; grid-template-columns: 1fr 1.15fr; gap: 4rem; align-items: center; padding: 4rem 0; border-bottom: 1px solid var(--color-border); }
  article:nth-child(even) .image-link { order: 2; }
  .image-link img { width: 100%; height: auto; object-fit: contain; display: block; background: var(--color-bg-offset); }
  .copy > span { color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 1rem; font-weight: 700; }
  .copy h2 { border: 0; display: block; padding: 0; font-size: 1.5rem; margin: 0.8rem 0 1rem; }
  .copy p { font-size: 1.12rem; line-height: 1.65; }
  .copy a { font-weight: 600; font-size: 1.05rem; }
  @media (max-width: 760px) { article { grid-template-columns: 1fr; gap: 2rem; } article:nth-child(even) .image-link { order: 0; } }
</style>
