---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import projectsData from '../data/projects.json';
import { url } from '../utils/paths';
const visibleProjects = projectsData.filter((project) => !('showOnProjects' in project) || project.showOnProjects !== false);
const projectGroups = [
  {
    id: 'materials-projects',
    title: 'Materials discovery & machine learning',
    description: 'Generative models and data-centric methods for materials discovery and atomistic analysis.',
    overviewImage: undefined,
    projects: visibleProjects.filter((project) => !('series' in project)),
  },
  {
    id: 'deepstem-series',
    title: 'DeepSTEM research series',
    description: 'Machine-learning methods for processing, interpreting, and extracting scientific insight from atomic-resolution microscopy data.',
    overviewImage: '/images/projects/deepstem/deepstem-overview.jpg',
    projects: visibleProjects.filter((project) => 'series' in project && project.series === 'DeepSTEM'),
  },
];

const getHref = (project: any) => project.route ? url(project.route) : project.link;
const isExternal = (project: any) => Boolean(project.link && !project.route);
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`Projects | ${SITE_TITLE}`} description="Selected research and open-source projects" /></head>
  <body>
    <Header />
    <main>
      <section class="page-hero">
        <h1>Research projects</h1>
        <div>Generative materials models, scientific machine learning, and open tools for microscopy.</div>
      </section>
      {projectGroups.map((group) => (
        <section class="project-group" id={group.id}>
          <div class="group-heading">
            <h2>{group.title}</h2>
            <p>{group.description}</p>
          </div>
          {group.overviewImage && (
            <figure class="group-overview" style="margin: 0 0 3.5rem; width: 100%; max-width: 100%; overflow: hidden;">
              <img
                src={url(group.overviewImage)}
                alt="DeepSTEM workflow from microscopy data processing through model analysis to scientific discovery"
                loading="lazy"
                style="display: block; width: 100%; max-width: 100%; height: auto; box-sizing: border-box; border: 0;"
              />
            </figure>
          )}
          <div class="project-list">
            {group.projects.map((project) => (
              <article>
                {getHref(project) ? (
                  <a
                    class="image-link"
                    href={getHref(project)}
                    target={isExternal(project) ? '_blank' : undefined}
                    rel={isExternal(project) ? 'noopener noreferrer' : undefined}
                  >
                    <img src={url(project.heroImage)} alt={project.title} />
                  </a>
                ) : (
                  <div class="image-link">
                    <img src={url(project.heroImage)} alt={project.title} />
                  </div>
                )}
                <div class="copy">
                  <span>{project.year} · {project.status}</span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  {getHref(project) && (
                    <a
                      href={getHref(project)}
                      target={isExternal(project) ? '_blank' : undefined}
                      rel={isExternal(project) ? 'noopener noreferrer' : undefined}
                    >
                      {isExternal(project) ? 'View project ↗' : 'Read project →'}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-hero { padding: 0 0 5rem; }
  h1 { margin-bottom: 1.5rem; }
  .page-hero > div { max-width: 680px; color: var(--color-text-muted); font-size: 1.2rem; }
  .project-group { scroll-margin-top: 6rem; margin-bottom: 6rem; }
  .group-heading { max-width: 760px; margin-bottom: 2.5rem; }
  .group-heading h2 { margin: 0 0 0.85rem; border: 0; padding: 0; font-size: 2rem; }
  .group-heading p { margin: 0; font-size: 1.12rem; line-height: 1.65; }
  .group-overview { margin: 0 0 3.5rem; }
  .group-overview img { display: block; width: 100%; height: auto; border: 0; background: #fff; }
  .project-list { border-top: 1px solid var(--color-border); }
  article { display: grid; grid-template-columns: 1fr 1.15fr; gap: 4rem; align-items: center; padding: 4rem 0; border-bottom: 1px solid var(--color-border); }
  article:nth-child(even) .image-link { order: 2; }
  .image-link img { width: 100%; height: auto; object-fit: contain; display: block; background: var(--color-bg-offset); }
  .copy > span { color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 1rem; font-weight: 700; }
  .copy h3 { border: 0; display: block; padding: 0; color: var(--color-text-main); font-family: var(--font-serif); font-size: 1.5rem; margin: 0.8rem 0 1rem; }
  .copy p { font-size: 1.12rem; line-height: 1.65; }
  .copy a { font-weight: 600; font-size: 1.05rem; }
  @media (max-width: 760px) { article { grid-template-columns: 1fr; gap: 2rem; } article:nth-child(even) .image-link { order: 0; } }
</style>
